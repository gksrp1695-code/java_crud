<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crud.mapper.BoardMapper">
    <!--
        MyBatis = Java와 DB를 연결해주는 다리 역할
        Mapper XML = SQL 쿼리를 따로 관리하는 파일
    -->

    <!--
        MyBatis Mapper XML 파일
        Java 코드 대신 이 파일에 SQL 쿼리를 작성합니다.
        namespace = 이 파일과 연결될 Java 인터페이스 경로
    -->

    <!-- 게시글 전체 조회 -->
    <!-- id = Java에서 호출할 메서드 이름 -->
    <!-- parameterType = 입력 -->
    <!-- resultType = 출력 -->

    <!-- 게시글 전체 조회 -->
    <select id="selectAll" resultType="com.crud.dto.BoardDto">
        SELECT * FROM boards
    </select>

    <!-- 게시글 1개 조회 -->
    <select id="selectOne" parameterType="int" resultType="com.crud.dto.BoardDto">
        SELECT * FROM boards WHERE board_no = #{board_no}
    </select>

    <!-- 게시글 등록 -->
    <insert id="insert" parameterType="com.crud.dto.BoardDto">
        INSERT INTO boards (board_title, mem_id, board_content, board_date)
        VALUES (#{board_title}, #{mem_id}, #{board_content}, NOW())
    </insert>

    <!-- 게시글 수정 -->
    <update id="update" parameterType="com.crud.dto.BoardDto">
        UPDATE boards
        SET board_title = #{board_title}, board_content = #{board_content}
        WHERE board_no = #{board_no}
    </update>

    <!-- 게시글 삭제 -->
    <delete id="delete" parameterType="int">
        DELETE FROM boards WHERE board_no = #{board_no}
    </delete>

    <!-- 조회수 증가 - 게시글 클릭할 때마다 +1 -->
    <update id="updateView" parameterType="int">
        UPDATE boards
        SET board_view = board_view + 1
        WHERE board_no = #{board_no}
    </update>

</mapper>

